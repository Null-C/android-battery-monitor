<?xml version="1.0" encoding="utf-8"?>
<!--
  浅色工程风紧凑布局。

  约定：
  · 颜色一律 @color/ 引用，尺寸一律 @dimen/ 引用，不在本文件写字面量
  · 面板用 @drawable/bg_panel 的细描边分隔，不用 elevation 阴影
  · 页面底色由主题的 windowBackground 提供，根节点不重复铺一层
  · 15 个 id 与 MainActivity.initViews() 一一对应，重排时不得删除或改名，
    也不得把某个 id 挪到非 TextView 的 View 上（后者会导致运行时 ClassCastException）
  · 本文件内只能使用 strings.xml 已有的文案，不新增任何可见文字
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/page_padding">

        <!-- ① 顶部条：应用名 + 常亮倒计时（同一行，倒计时在最右） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_panel"
            android:padding="@dimen/panel_padding"
            android:layout_marginBottom="@dimen/block_gap">
            <!-- 不设 baselineAligned="false"：两个不同字号的文字同排，按基线对齐才是正确的排版，
                 且倒计时（10sp）的上下缘都落在标题（13sp）的行框内，行高不会被撑大 -->

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                style="@style/TopBarTitle" />

            <TextView
                android:id="@+id/tvScreenOnCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/screen_on_countdown_idle"
                style="@style/CountdownText" />
        </LinearLayout>

        <!-- ② 电流读数 + 统计 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_panel"
            android:padding="@dimen/panel_padding"
            android:layout_marginBottom="@dimen/block_gap">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_realtime_current"
                style="@style/PanelLabel" />

            <TextView
                android:id="@+id/tvCurrentCurrent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/current_placeholder"
                style="@style/Reading" />

            <!-- 最低 / 最高 / 平均：一行三列，标签在上、数值在下 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:layout_marginTop="@dimen/row_gap">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/label_min_current"
                        style="@style/StatLabel" />

                    <TextView
                        android:id="@+id/tvCurrentMin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/dash_placeholder"
                        style="@style/StatValue" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/label_max_current"
                        style="@style/StatLabel" />

                    <TextView
                        android:id="@+id/tvCurrentMax"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/dash_placeholder"
                        style="@style/StatValue" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/label_avg_current"
                        style="@style/StatLabel" />

                    <TextView
                        android:id="@+id/tvCurrentAvg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/dash_placeholder"
                        style="@style/StatValue" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ③ 电流趋势 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_panel"
            android:padding="@dimen/panel_padding"
            android:layout_marginBottom="@dimen/block_gap">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_current_chart"
                style="@style/SectionTitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/chart_axis_note"
                style="@style/NoteText" />

            <com.batterymonitor.app.view.CurrentChartView
                android:id="@+id/chartCurrent"
                android:layout_width="match_parent"
                android:layout_height="@dimen/chart_height"
                android:layout_marginTop="@dimen/row_gap" />
        </LinearLayout>

        <!-- ④ 温度趋势 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_panel"
            android:padding="@dimen/panel_padding"
            android:layout_marginBottom="@dimen/block_gap">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_temperature_chart"
                style="@style/SectionTitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/chart_axis_note_temperature"
                style="@style/NoteText" />

            <com.batterymonitor.app.view.TemperatureChartView
                android:id="@+id/chartTemperature"
                android:layout_width="match_parent"
                android:layout_height="@dimen/chart_height"
                android:layout_marginTop="@dimen/row_gap" />
        </LinearLayout>

        <!-- ⑤ 电量趋势 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_panel"
            android:padding="@dimen/panel_padding"
            android:layout_marginBottom="@dimen/block_gap">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_battery_level_chart"
                style="@style/SectionTitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/chart_axis_note_level"
                style="@style/NoteText" />

            <com.batterymonitor.app.view.BatteryLevelChartView
                android:id="@+id/chartBatteryLevel"
                android:layout_width="match_parent"
                android:layout_height="@dimen/chart_height"
                android:layout_marginTop="@dimen/row_gap" />
        </LinearLayout>

        <!-- ⑥ 电池信息：2 行 2 列 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_panel"
            android:padding="@dimen/panel_padding"
            android:layout_marginBottom="@dimen/block_gap">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_battery_info"
                style="@style/SectionTitle" />

            <!-- 左半固定 50%，右半固定 50%：不要写成"标签+数值+标签+数值"的单行四孩子结构，
                 否则每行数值宽度不同会让第二列起点逐行错位 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:layout_marginTop="@dimen/row_gap">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_level"
                        style="@style/PanelLabel" />

                    <TextView
                        android:id="@+id/tvBatteryLevel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:gravity="end"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/battery_level_placeholder"
                        android:textColor="@color/accent_battery_level"
                        style="@style/PanelValue" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/panel_padding"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_health"
                        style="@style/PanelLabel" />

                    <TextView
                        android:id="@+id/tvBatteryHealth"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:gravity="end"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/dash_placeholder"
                        style="@style/PanelValue" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_height"
                android:background="@color/divider"
                android:layout_marginTop="@dimen/row_gap"
                android:layout_marginBottom="@dimen/row_gap" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_temperature"
                        style="@style/PanelLabel" />

                    <TextView
                        android:id="@+id/tvBatteryTemp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:gravity="end"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/battery_temp_placeholder"
                        android:textColor="@color/accent_temperature"
                        style="@style/PanelValue" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/panel_padding"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_voltage"
                        style="@style/PanelLabel" />

                    <TextView
                        android:id="@+id/tvBatteryVoltage"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:gravity="end"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/battery_voltage_placeholder"
                        style="@style/PanelValue" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ⑦ 设备信息：2 行 2 列（末格留空） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_panel"
            android:padding="@dimen/panel_padding"
            android:layout_marginBottom="@dimen/block_gap">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_device_info"
                style="@style/SectionTitle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:layout_marginTop="@dimen/row_gap">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_model"
                        style="@style/PanelLabel" />

                    <TextView
                        android:id="@+id/tvPhoneModel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:gravity="end"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/dash_placeholder"
                        style="@style/PanelValue" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/panel_padding"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_manufacturer"
                        style="@style/PanelLabel" />

                    <TextView
                        android:id="@+id/tvManufacturer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:gravity="end"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/dash_placeholder"
                        style="@style/PanelValue" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_height"
                android:background="@color/divider"
                android:layout_marginTop="@dimen/row_gap"
                android:layout_marginBottom="@dimen/row_gap" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_system"
                        style="@style/PanelLabel" />

                    <TextView
                        android:id="@+id/tvAndroidVersion"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:gravity="end"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/dash_placeholder"
                        style="@style/PanelValue" />
                </LinearLayout>

                <!-- 末格留空：只保留左半，维持两列对齐 -->
                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>

        <!-- ⑧ 说明文字 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_panel"
            android:padding="@dimen/panel_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/note_text"
                style="@style/NoteText" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>